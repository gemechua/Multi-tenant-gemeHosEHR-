rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function getUserData() { return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null; }
    function hasRole(role) { return isSignedIn() && getUserData() != null && getUserData().role == role; }

    match /beds/{id} {
      allow read, write: if true;
    }
    // ADMIN
    match /executive_kpi_dashboard/{id} {
      allow read, write: if true;
    }
    match /staff_credentialing/{id} {
      allow read, write: if true;
    }
    match /facility_assets/{id} {
      allow read, write: if true;
    }
    match /lab_test_catalog/{id} {
      allow read, write: if true;
    }
    match /lab_orders/{id} {
      allow read, write: if true;
    }
    match /lab_samples/{id} {
      allow read, write: if true;
    }
    match /lab_results/{id} {
      allow read, write: if true;
    }
    match /radiology_catalog/{id} {
      allow read, write: if true;
    }
    match /radiology_orders/{id} {
      allow read, write: if true;
    }
    match /radiology_reports/{id} {
      allow read, write: if true;
    }
    match /clinical_patients/{id} {
      allow read, write: if true;
    }
    match /clinical_encounters/{id} {
      allow read, write: if true;
    }
    match /clinical_vitals/{id} {
      allow read, write: if true;
    }
    match /financial_services/{id} {
      allow read, write: if true;
    }
    match /financial_invoices/{id} {
      allow read, write: if true;
    }
    match /financial_payments/{id} {
      allow read, write: if true;
    }
    match /fin_patient_ledger/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /audit_log/{id} {
      allow read: if true;
      allow write: if true; // Audit logs should only be created by system triggers
    }
    match /hospitals/{id} {
      allow read, write: if true;
    }
    match /departments/{id} {
      allow read, write: if true;
    }
    match /pre_triage_records/{id} {
      allow read, write: if true;
    }
    match /patient_payments/{id} {
      allow read, write: if true;
    }
    match /cashier_payment_verifications/{id} {
