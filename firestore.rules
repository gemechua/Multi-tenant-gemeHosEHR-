      allow read, write: if true;
    }
    match /patient_radiology_payments/{id} {
      allow read, write: if true;
    }
    match /patient_laboratory_investigation_requests/{id} {
      allow read, write: if true;
    }
    match /patient_radiology_investigation_requests/{id} {
      allow read, write: if true;
    }
    match /antenatal_episodes/{id} {
      allow read, write: if true;
